# ═══════════════════════════════════════════════════════════════
#  DropAgentX — نمونهٔ متغیرهای محیطی برای Railway
#  این فایل را در Railway → Variables وارد کن (یا هر خط KEY=VALUE را
#  با «Raw Editor» پیست کن). این فایل هرگز commit نمی‌شود.
# ═══════════════════════════════════════════════════════════════

# ── ۱) اجباری — بات تلگرام ─────────────────────────────
# از @BotFather بگیر. اگر خالی بگذاری، فقط بخش وب بالا می‌آید (وب‌تنها).
BOT_TOKEN=

# آیدی عددی ادمین‌ها، با کاما. از @userinfobot بگیر.
# بدون این، پنل ادمین بات و seed محصولات دمو کار نمی‌کند.
ADMIN_IDS=

# ── ۲) اجباری — وب و امنیت ─────────────────────────────
# رمز ورود /admin و /login
WEB_PASSWORD=

# کلید تصادفی امضای کوکی ادمین. با این دستور بساز:
#   python -c "import secrets;print(secrets.token_hex(32))"
WEB_SECRET=

# پشت HTTPS ریلوی حتماً 1 باشد (کوکی Secure)
COOKIE_SECURE=1

# ── ۳) ذخیره‌سازی — حیاتی روی Railway ──────────────────
# بدون Volume، دیتابیس و آپلودها با هر Redeploy پاک می‌شوند.
# یک Volume با mount path = /data بساز و همین DATA_DIR را ست کن.
DATA_DIR=/data

# ── ۴) هوش مصنوعی (اختیاری ولی توصیه‌شده) ──────────────
# گزینهٔ A — Gemini (کلید رایگان از https://aistudio.google.com/apikey)
# AI_API_KEY=<google_api_key>
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-2.0-flash
#
# گزینهٔ B — OpenRouter
# AI_API_KEY=<openrouter_key>
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=openai/gpt-4o-mini
#
# گزینهٔ C — OpenAI
# AI_API_KEY=<openai_key>
# AI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
IMAGE_GEN_BACKEND=auto

# ── ۵) اقتصاد داخلی (پیش‌فرض‌ها معمولاً درست‌اند) ──────
COMMISSION_RATE=0.10
CREDITS_PER_USDT=1000
WELCOME_CREDITS=50
DAILY_BONUS_BASE=15
DAILY_BONUS_CAP=50

# ── ۶) کیف‌پول‌ها (فقط اگر پرداخت کریپتویی فعال می‌کنی) ─
WALLET_TON=
WALLET_BSC=
WALLET_SOL=
WALLET_TRX=

# ── ۷) سرویس‌های جانبی ────────────────────────────────
# A2A و MCP پورت‌های جدا می‌خواهند و روی Railway سرویس عمومی نمی‌گیرند.
# خاموش بمانند تا healthcheck و پورت اصلی سالم بماند.
A2A_ENABLED=0

# حالت اجرا (railway به‌صورت خودکار از RAILWAY_ENVIRONMENT تشخیص داده می‌شود)
DAX_MODE=railway

# ── ۸) لاگ ─────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_TO_DB=1
